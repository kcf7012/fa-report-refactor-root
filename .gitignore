# ============================================
# FA Report 專案根目錄 .gitignore
# ============================================

# 環境變數(包含 API key)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Virtual Environment
venv/
env/
.venv/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
*~
*.tmp
*.bak
*.log

# ============================================
# 技能包(.agents/skills/fa-report-improvement/)
# 內部已有獨立 git 版本控制,不納入根倉庫
# 詳見 docs/README.md
# ============================================
.agents/

# ============================================
# 暫存 / 測試文件
# ============================================
/tmp/
/test/
*.tmp
# WSL metadata files
*:Zone.Identifier
HANDOFF.md

# smoke test 產物(由 tests/integration/test_slide_rendering.py 生成)
report/*_smoke.pptx
report/*_smoke_bounds.pptx
report/*_smoke_dyn.pptx
report/*_improved_v2.pptx

# visual_quality test 產物(由 tests/integration/test_visual_quality.py 生成)
# 給 _run_improvement() 用的 output_suffix 一律以 _vq 開頭。
# 原本是一個 suffix 一行列舉,新增測試時必漏 —— P4 加了三支測試就漏了三個
# (_vqphleft / _vqdecov / _vqbodydec),污染根倉庫的 git status。改用萬用字元。
report/*_vq*.pptx

# 視覺驗證腳本產物(由 scripts/visual_smoke_test.py 生成)
# 既有 v3.1.2 改善檔的視覺驗證圖,以「_improved_visual」結尾的目錄
report/*_improved_visual/

# 臨時交接文檔(任務完成後可刪除)

# Playwright CLI 工作目錄(session / snapshot / screenshot 等)
.playwright-cli/

# Playwright 操作截圖(放進 repo 作為 PR/Merge 教學文件的引用資源,但本地重新操作會再生)
# 注意:docs/handoff/screenshots/ 內的截圖是「教學文件的一部分」,刻意 commit 進去
#       只有 .playwright-cli/ 是 agent 操作過程的暫存,不該 commit

# v3.1.4-regression-fix 改善過程的中間產物(僅 v3_final 是最終版)
report/*_regression_improved.pptx
report/*_regression_v2_improved.pptx
# Kenny 上傳 Google 雲端的驗收副本(不該 commit 到 repo,Kenny 本地保留)
report/*_v3_final_improved.pptx
report/*.manifest.json
